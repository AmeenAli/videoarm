# Copy to .env (git-ignored) and fill in. The API server loads this on startup.

# --- Core ---
VIDEOARM_API_KEY=change-me
# VIDEOARM_OUTPUT_DIR=/tmp/videoarm_jobs

# --- YouTube downloads (yt-dlp) ---
# This server runs on a GCP datacenter IP, which YouTube blocks with
# "Sign in to confirm you're not a bot". To download YouTube links you must
# present a non-datacenter network identity via ONE of the following:

# 1) Residential proxy (recommended for a multi-user server). yt-dlp sends its
#    requests out through this instead of the GCP IP.
# VIDEOARM_YTDLP_PROXY=http://USER:PASS@HOST:PORT

# 2) Cookies from a logged-in (ideally dedicated/throwaway) YouTube account.
# VIDEOARM_YTDLP_COOKIES=/home/ameenali/videoarm/cookies.txt
